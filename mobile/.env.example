# Copy to .env.local (or export directly) and adjust for your setup.
# On a physical device / emulator, "localhost" won't reach your dev machine —
# use your LAN IP (e.g. http://192.168.1.20:4000) or an Expo/ngrok tunnel.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Stripe *publishable* key (safe to ship — not the secret key). Leave empty to
# run without in-app payments; the payment screen shows a clear message instead
# of crashing. Get a test key at https://dashboard.stripe.com/test/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
