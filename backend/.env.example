DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4000
# Radius (km) used when broadcasting a new request to nearby locksmiths
BROADCAST_RADIUS_KM=15
# Seconds a locksmith has to accept a request before it re-broadcasts / expands radius
ACCEPT_TIMEOUT_SECONDS=20
# How far (km) the search radius grows on each re-broadcast when nobody accepts
RADIUS_STEP_KM=10
# Search radius (km) never expands past this
MAX_RADIUS_KM=50
# Extra re-broadcasts once the radius has maxed out before the request auto-cancels
MAX_ATTEMPTS_AT_MAX_RADIUS=2
# Fee (EUR) charged to the client for cancelling after a locksmith already accepted
LATE_CANCELLATION_FEE_EUR=15
# A locksmith who cancels this many accepted jobs gets auto-suspended
MAX_LOCKSMITH_CANCELLATIONS=3

# --- Stripe Connect (in-app payments) ---
# Leave unset in dev: payment endpoints will return a clear error instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Percentage of each job's price kept by the platform (client pays finalPrice, locksmith
# receives finalPrice minus this cut).
PLATFORM_FEE_PERCENT=15
# Where Stripe redirects the locksmith's browser after Connect onboarding
STRIPE_ONBOARDING_REFRESH_URL=https://example.com/stripe/refresh
STRIPE_ONBOARDING_RETURN_URL=https://example.com/stripe/return

# --- Admin bootstrap (see prisma/seed.ts) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
