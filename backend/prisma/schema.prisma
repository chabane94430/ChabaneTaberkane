// Prisma schema for the locksmith on-demand marketplace.
// SQLite is used for local/dev simplicity; swap the datasource to Postgres for production
// (Postgres supports native enums — see src/types.ts for the string-literal unions these
// fields are validated against at the API boundary via zod, since SQLite has no enum type).
// See README.md "Passer en production" for the SQLite -> PostgreSQL migration steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String // "CLIENT" | "LOCKSMITH" | "ADMIN"
  fullName     String
  phone        String?
  pushToken    String? // Expo push token for the device currently logged in
  createdAt    DateTime @default(now())

  // Client side
  requestsMade    ServiceRequest[] @relation("ClientRequests")
  reviewsWritten  Review[]         @relation("ReviewAuthor")
  messagesSent    Message[]        @relation("MessageSender")

  // Locksmith side
  locksmithProfile LocksmithProfile?
  requestsHandled  ServiceRequest[]  @relation("LocksmithRequests")
  reviewsReceived  Review[]          @relation("ReviewTarget")
}

model LocksmithProfile {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @unique
  isOnline        Boolean   @default(false)
  latitude        Float?
  longitude       Float?
  lastLocationAt  DateTime?
  ratingAvg       Float     @default(5)
  ratingCount     Int       @default(0)
  bio             String?
  yearsExperience Int?      @default(0)

  // Identity verification
  idDocumentUrl      String?
  verificationStatus String  @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED

  // Cancellation policy
  cancelledJobsCount Int     @default(0)
  suspended          Boolean @default(false)

  // Stripe Connect (payouts)
  stripeAccountId  String?
  stripeOnboarded  Boolean @default(false)
}

model ServiceRequest {
  id          String @id @default(cuid())
  client      User   @relation("ClientRequests", fields: [clientId], references: [id])
  clientId    String
  locksmith   User?  @relation("LocksmithRequests", fields: [locksmithId], references: [id])
  locksmithId String?

  issueType   String // DOOR_LOCKOUT | CAR_LOCKOUT | LOCK_CHANGE | BROKEN_KEY | SAFE_OPENING | SECURITY_UPGRADE | OTHER
  description String?
  latitude    Float
  longitude   Float
  address     String?

  status           String @default("PENDING") // PENDING | ACCEPTED | ARRIVED | COMPLETED | CANCELLED
  priceEstimateMin Int?
  priceEstimateMax Int?
  finalPrice       Int?
  cancellationFee  Int? // charged to the client for a late cancellation once a locksmith was already en route

  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String? // CLIENT_CANCELLED | LOCKSMITH_CANCELLED | NO_LOCKSMITH_AVAILABLE

  // Payment (Stripe Connect: platform collects from client, transfers to locksmith minus fee)
  paymentStatus   String  @default("UNPAID") // UNPAID | PENDING | PAID | FAILED
  paymentIntentId String? @unique
  paidAt          DateTime?

  review Review?
  photos RequestPhoto[]
  messages Message[]
}

model RequestPhoto {
  id        String         @id @default(cuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  requestId String
  url       String
  createdAt DateTime       @default(now())
}

model Message {
  id        String         @id @default(cuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  requestId String
  sender    User           @relation("MessageSender", fields: [senderId], references: [id])
  senderId  String
  body      String
  createdAt DateTime       @default(now())

  @@index([requestId, createdAt])
}

model Review {
  id        String         @id @default(cuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  requestId String         @unique
  author    User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId  String
  target    User           @relation("ReviewTarget", fields: [targetId], references: [id])
  targetId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

// Admin-adjustable price bands per issue type — overrides the hardcoded defaults in
// src/utils/geo.ts's estimatePrice() when present. Geographic zoning (e.g. per-city
// multipliers) is out of scope for this MVP since it would require a geocoding service;
// see README.md "Pistes pour la suite".
model PricingRule {
  id        String   @id @default(cuid())
  issueType String   @unique
  priceMin  Int
  priceMax  Int
  updatedAt DateTime @updatedAt
}
